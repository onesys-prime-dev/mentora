# Every setting of the `env` template, filled in (audit decision 14.2).
#
# CI copies this over .env and runs the PHP tests a second time, so a test that
# only passes while a setting is unset fails there, the way it would on a
# developer's machine with a full .env. The values are harmless: nothing here
# reaches a real service. The database is CI's throw-away MySQL container.
# tests/unit/CiFullEnvTest.php checks every key of `env` is set here.

CI_ENVIRONMENT = testing

app.baseURL = 'http://localhost:8080/'
app_baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

database.default.hostname = 127.0.0.1
database.default.database = mentora_test
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

database.tests.hostname = 127.0.0.1
database.tests.database = mentora_test
database.tests.username = root
database.tests.password =
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_general_ci
database.tests.port = 3306

email.protocol = smtp
email.SMTPHost = 127.0.0.1
email.SMTPPort = 9
email.SMTPCrypto = tls
email.SMTPUser = ci@example.test
email.SMTPPass = ci-smtp-password-not-real
email.fromEmail = ci@example.test
email.fromName = "Mentora CI"
email.SMTPTimeout = 1

questionBuilder.workerSecret = ci-worker-secret-not-real
questionBuilder.useJobs = true
questionBuilder.serviceUrl = http://127.0.0.1:9

scheduler.checkSecret = ci-scheduler-secret-not-real

backup.path = /tmp/mentora-ci-backups
backup.offsiteCommand = /bin/false

encryption.key = hex2bin:6d656e746f72612d63692d6b65792d6e6f742d7265616c2d33322d62797465
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null

logger.threshold = 4
