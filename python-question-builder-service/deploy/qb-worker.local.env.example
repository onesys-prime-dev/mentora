# For running the worker on your own machine against your local Mentora.
#
#   copy deploy\qb-worker.local.env.example .env      (in python-question-builder-service\)
#   then fill in the two secrets and run  .\run-worker.ps1
#
# The .env file is git-ignored. Never commit it, and never share the key.

# Your local site (XAMPP). The endpoints answer only to this machine.
QB_PHP_URL=https://localhost/mentora/public

# XAMPP's certificate is self-signed, so certificate checking has to be off for
# the call to your own local site. This never applies to the call to Groq.
QB_PHP_VERIFY_TLS=false

# The same value as questionBuilder.workerSecret in the site's .env.
QB_WORKER_SECRET=

# A key from console.groq.com. Use a different key from staging's, so local
# testing cannot use up the staging allowance.
GROQ_API_KEY=

QB_BACKEND=groq
QB_WORKER_ID=local-1

# Optional. Models tried in order; each has its own free limits.
# QB_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
