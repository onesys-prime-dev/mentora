# Copy to /etc/mentora/qb-worker-<env>.env (owner root, mode 600) and fill in.
# Never commit the real file. Staging and production each have their own copy
# and share NO value with each other.

# Where the worker reaches Mentora: the loopback address of THIS site's own
# nginx listener (the endpoints refuse anything that is not 127.0.0.1 / ::1).
# On the current VPS: production http://127.0.0.1:18080, staging http://127.0.0.1:18081.
QB_PHP_URL=http://127.0.0.1:18080

# The same value as questionBuilder.workerSecret in THIS site's .env. Make a
# different one per environment: openssl rand -hex 32
QB_WORKER_SECRET=

# A stable name, so the monitoring page and the heartbeat table show one row
# per environment instead of a new "host-pid" row after every restart.
QB_WORKER_ID=production-1

# groq (the free default) or fake (no model; for smoke tests).
QB_BACKEND=groq

# A key from the Groq console. Staging and production MUST use different keys,
# ideally from different Groq organisations: the free allowance is per
# organisation, and a test run on staging would otherwise use up production's.
GROQ_API_KEY=

# Staging only, when the site's certificate is self-signed and QB_PHP_URL is an
# https address: set to false so the worker accepts it. Not needed for the
# loopback http address above; leave unset anywhere with a real certificate.
# QB_PHP_VERIFY_TLS=false

# Optional. Models tried in order; each has its own free limits.
# QB_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# QB_BASE_URL=https://api.groq.com/openai/v1
