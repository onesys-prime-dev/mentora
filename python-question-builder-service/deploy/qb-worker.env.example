# Copy to /etc/mentora/qb-worker.env (mode 600) and fill in. Never commit the real file.

# Where the worker reaches Mentora. Loopback only: the endpoints refuse anything else.
QB_PHP_URL=http://127.0.0.1

# The same value as questionBuilder.workerSecret in Mentora's .env.
QB_WORKER_SECRET=

# groq (the free default) or fake (no model; for smoke tests).
QB_BACKEND=groq

# A key from the Groq console. Use a separate organisation or key for staging
# so tests there cannot use up production's free allowance.
GROQ_API_KEY=

# Optional. Models tried in order; each has its own free limits.
# QB_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# QB_BASE_URL=https://api.groq.com/openai/v1
# QB_WORKER_ID=production-1