#--------------------------------------------------------------------
# EMAIL
#--------------------------------------------------------------------
# Needed for anything that must reach a real inbox, above all the 6-digit
# sign-in code of a system administrator. Without it the app uses PHP mail(),
# which does nothing useful on most machines. Full guide: docs/mail.md.
# Then check it with:  php spark mail:test you@yourdomain.com
#
# The From address must be the address you log in to the mail server with
# (Gmail and most providers rewrite or refuse anything else).
#
# email.protocol = smtp
# email.SMTPHost = smtp.gmail.com
# email.SMTPPort = 587
# email.SMTPCrypto = tls
# email.SMTPUser = you@gmail.com
# email.SMTPPass = your-16-letter-app-password
# email.fromEmail = you@gmail.com
# email.fromName = "Mentora LMS"
# email.SMTPTimeout = 15

#--------------------------------------------------------------------
# QUESTION BUILDER (AI question generation)
#--------------------------------------------------------------------
# Generation runs in a separate worker process that asks Mentora for queued
# jobs over loopback. Full setup: docs/deploy.md ("The question-builder worker").
#
# Both values below are optional while the feature is off. Nothing here is a
# provider key: the Groq key lives only in the worker's own environment file.

# The shared secret between this app and the worker. You make it up: a long
# random string, e.g.  php -r "echo bin2hex(random_bytes(32));"
# The SAME value goes in the worker's QB_WORKER_SECRET. Use a different one on
# staging and production. While empty, /internal/ai/* answers 503 on purpose.
# questionBuilder.workerSecret =

# Set to true to generate questions as background jobs for the worker. False
# (or unset) keeps the original in-request service, which needs the old
# Python service running on questionBuilder.serviceUrl.
# questionBuilder.useJobs = false

# The original in-request service (also still used to read uploaded files).
# questionBuilder.serviceUrl = http://127.0.0.1:8008

#--------------------------------------------------------------------
# SCHEDULED JOBS AND BACKUPS (docs/server-setup.md, section 6)
#--------------------------------------------------------------------

# The secret the hourly uptime workflow sends to POST internal/scheduler-check,
# which emails the system administrators when a scheduled job stops. The SAME
# value goes in GitHub's SCHEDULER_SECRET_STAGING or SCHEDULER_SECRET_PRODUCTION.
# While empty, the check answers 503 on purpose.
# scheduler.checkSecret =

# Where the backups go (default writable/backups), and, on production only, the
# command that copies each good backup off the server. It gets two arguments:
# the dump's path and the uploads folder; exit 0 means the copy is verified.
# backup.path =
# backup.offsiteCommand =

